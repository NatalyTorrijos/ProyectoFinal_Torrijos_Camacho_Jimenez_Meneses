  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Caballero, present\xEDa vuestra llegada.\nLos orcos me han despojado de
    dos pertenencias esenciales: una ca\xF1a de pescar y una bolsa, y han huido con
    ellas. Requiero de vuestra ayuda para recuperarlas.\nTomaron el camino que yace
    a la diestra de la aldea. Esto podr\xEDa acercaros a vuestro anhelo de volver
    a vuestro hogar.\n\n\u2014 Merl\xEDn."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
