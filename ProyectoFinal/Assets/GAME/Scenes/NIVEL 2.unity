  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Gracias por vuestra valiosa ayuda, joven aventurero.\nGracias a vos, el
    molino podr\xE1 seguir girando, y con ello la aldea prosperar\xE1.\nComo recompensa
    por vuestro noble actuar, el camino hacia vuestro hogar os ha sido concedido.\nDetr\xE1s
    del molino, un portal ha despertado; atravesadlo cuando est\xE9is listo para
    partir.\n\n\u2014 Merl\xEDn.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
